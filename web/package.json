{
  "name": "dentection-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-runtime.mjs && vite --host 127.0.0.1",
    "build": "node scripts/copy-runtime.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && vite build",
    "test": "vitest run",
    "preview": "wrangler dev --ip 127.0.0.1",
    "deploy": "pnpm build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply dentection-db --local",
    "db:remote": "wrangler d1 migrations apply dentection-db --remote",
    "preview:local": "wrangler dev --config wrangler.local.jsonc --ip 127.0.0.1"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "onnxruntime-web": "^1.30.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
