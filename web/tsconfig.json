{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"],
    "noUnusedLocals": true, "noUnusedParameters": true, "strict": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src"], "exclude": ["src/proof.ts"]
}
